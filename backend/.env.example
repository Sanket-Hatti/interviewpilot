# Copy this file to .env and fill in your real values
# NEVER commit .env to Git

# Flask
FLASK_ENV=development

# Database — get connection string from neon.tech
DATABASE_URL=postgresql://username:password@hostname/dbname?sslmode=require

# JWT — generate a strong random string (e.g. python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=replace-with-a-long-random-secret

# LLM / Groq AI
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b
MODEL_NAME=qwen/qwen3.8-27b

# Embeddings & RAG
# Provider options: fastembed (default, local BAAI/bge-small-en-v1.5) or openai
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_API_KEY=optional-if-using-openai-provider
OPENAI_API_KEY=optional-if-using-openai

# Gemini AI (optional)
GEMINI_API_KEY=your-gemini-api-key-here

# CORS — frontend origin (Vite default)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
